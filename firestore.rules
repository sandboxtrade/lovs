rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isExistingMember() {
      return signedIn() && request.auth.uid in resource.data.memberIds;
    }

    function isCoupleMember(coupleId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
    }

    function roomItemPrice(itemId) {
      return itemId == 'plant' ? 18
        : itemId == 'lamp' ? 22
        : itemId == 'rug' ? 28
        : itemId == 'photo_wall' ? 35
        : itemId == 'bookshelf' ? 45
        : itemId == 'moon_light' ? 60
        : -1;
    }

    function validNewCouple() {
      return signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds[0] == request.auth.uid
        && request.resource.data.members[request.auth.uid].uid == request.auth.uid;
    }

    function validJoin() {
      return signedIn()
        && !(request.auth.uid in resource.data.memberIds)
        && resource.data.memberIds.size() == 1
        && request.resource.data.memberIds.size() == 2
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members', 'updatedAt'])
        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid].uid == request.auth.uid;
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /couples/{coupleId} {
      allow create: if validNewCouple();
      allow read: if isExistingMember();
      allow update: if validJoin();
      allow delete: if false;

      match /presence/{userId} {
        allow read: if isCoupleMember(coupleId);
        allow create, update: if isCoupleMember(coupleId)
          && request.auth.uid == userId
          && request.resource.data.uid == userId
          && request.resource.data.keys().hasOnly([
            'uid',
            'status',
            'currentScreen',
            'lastSeen',
            'lastSeenClientMs'
          ])
          && request.resource.data.status in ['online', 'away'];
        allow delete: if false;
      }

      match /emotions/{userId} {
        allow read: if isCoupleMember(coupleId);
        allow create, update: if isCoupleMember(coupleId)
          && request.auth.uid == userId
          && request.resource.data.uid == userId
          && request.resource.data.keys().hasOnly([
            'uid',
            'emotionId',
            'intensity',
            'note',
            'updatedAt',
            'updatedAtClientMs'
          ])
          && request.resource.data.emotionId in [
            'miss_you',
            'love',
            'good',
            'calm',
            'tired',
            'sad',
            'stressed',
            'need_space'
          ]
          && request.resource.data.intensity is int
          && request.resource.data.intensity >= 0
          && request.resource.data.intensity <= 100
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 140
          && request.resource.data.updatedAtClientMs is int;
        allow delete: if false;
      }

      match /touches/{touchId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId)
          && request.resource.data.keys().hasOnly([
            'fromUid',
            'toUid',
            'type',
            'createdAt',
            'createdAtClientMs',
            'seenAt',
            'seenAtClientMs'
          ])
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.toUid != request.auth.uid
          && request.resource.data.toUid in get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds
          && request.resource.data.type in ['hug', 'kiss', 'near', 'hold_hand']
          && request.resource.data.createdAtClientMs is int
          && request.resource.data.seenAt == null
          && request.resource.data.seenAtClientMs == null;
        allow update: if isCoupleMember(coupleId)
          && resource.data.toUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenAt', 'seenAtClientMs'])
          && request.resource.data.seenAtClientMs is int;
        allow delete: if false;
      }


      match /gameActions/{gameActionId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId)
          && request.resource.data.keys().hasOnly([
            'uid',
            'type',
            'dayKey',
            'sourceId',
            'createdAt',
            'createdAtClientMs'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.type in [
            'emotion_daily',
            'touch_daily',
            'goal_create_daily',
            'contribution_daily',
            'question_daily',
            'choice_daily',
            'quest_daily'
          ]
          && request.resource.data.dayKey is string
          && request.resource.data.dayKey.size() == 10
          && request.resource.data.sourceId is string
          && request.resource.data.sourceId.size() <= 120
          && request.resource.data.createdAtClientMs is int
          && gameActionId == request.resource.data.type + '_' + request.resource.data.dayKey + '_' + request.auth.uid;
        allow update, delete: if false;
      }

      match /economy/{economyId} {
        allow read: if isCoupleMember(coupleId) && economyId == 'main';
        allow create: if isCoupleMember(coupleId)
          && economyId == 'main'
          && request.resource.data.keys().hasOnly([
            'spentCoins',
            'updatedAt',
            'updatedAtClientMs'
          ])
          && request.resource.data.spentCoins is int
          && request.resource.data.spentCoins >= 0
          && request.resource.data.spentCoins <= 60
          && request.resource.data.updatedAtClientMs is int;
        allow update: if isCoupleMember(coupleId)
          && economyId == 'main'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'spentCoins',
            'updatedAt',
            'updatedAtClientMs'
          ])
          && request.resource.data.spentCoins is int
          && request.resource.data.spentCoins >= resource.data.spentCoins
          && request.resource.data.spentCoins - resource.data.spentCoins <= 60
          && request.resource.data.updatedAtClientMs is int;
        allow delete: if false;
      }

      match /roomPurchases/{purchaseId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId)
          && request.resource.data.keys().hasOnly([
            'itemId',
            'cost',
            'purchasedBy',
            'purchasedAt',
            'purchasedAtClientMs'
          ])
          && purchaseId == request.resource.data.itemId
          && roomItemPrice(request.resource.data.itemId) > 0
          && request.resource.data.cost == roomItemPrice(request.resource.data.itemId)
          && request.resource.data.purchasedBy == request.auth.uid
          && request.resource.data.purchasedAtClientMs is int
          && (
            (
              exists(/databases/$(database)/documents/couples/$(coupleId)/economy/main)
              && getAfter(/databases/$(database)/documents/couples/$(coupleId)/economy/main).data.spentCoins
                == get(/databases/$(database)/documents/couples/$(coupleId)/economy/main).data.spentCoins
                  + request.resource.data.cost
            )
            ||
            (
              !exists(/databases/$(database)/documents/couples/$(coupleId)/economy/main)
              && getAfter(/databases/$(database)/documents/couples/$(coupleId)/economy/main).data.spentCoins
                == request.resource.data.cost
            )
          );
        allow update, delete: if false;
      }

      match /pet/{petId} {
        allow read: if isCoupleMember(coupleId) && petId == 'main';
        allow create: if isCoupleMember(coupleId)
          && petId == 'main'
          && request.resource.data.keys().hasOnly([
            'name',
            'lastInteractionType',
            'lastInteractedBy',
            'lastInteractionAt',
            'lastInteractionAtClientMs',
            'updatedAt',
            'updatedAtClientMs'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 20
          && request.resource.data.lastInteractionType == 'none'
          && request.resource.data.lastInteractedBy == request.auth.uid
          && request.resource.data.lastInteractionAt == null
          && request.resource.data.lastInteractionAtClientMs == 0
          && request.resource.data.updatedAtClientMs is int;
        allow update: if isCoupleMember(coupleId)
          && petId == 'main'
          && request.resource.data.keys().hasOnly([
            'name',
            'lastInteractionType',
            'lastInteractedBy',
            'lastInteractionAt',
            'lastInteractionAtClientMs',
            'updatedAt',
            'updatedAtClientMs'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 20
          && request.resource.data.lastInteractionType in ['none', 'pet', 'play', 'rest']
          && request.resource.data.lastInteractedBy in get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds
          && request.resource.data.lastInteractionAtClientMs is int
          && request.resource.data.updatedAtClientMs is int
          && request.resource.data.updatedAtClientMs >= resource.data.updatedAtClientMs
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name',
              'updatedAt',
              'updatedAtClientMs'
            ])
            ||
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'lastInteractionType',
                'lastInteractedBy',
                'lastInteractionAt',
                'lastInteractionAtClientMs',
                'updatedAt',
                'updatedAtClientMs'
              ])
              && request.resource.data.lastInteractedBy == request.auth.uid
              && request.resource.data.lastInteractionType in ['pet', 'play', 'rest']
              && request.resource.data.lastInteractionAtClientMs > 0
            )
          );
        allow delete: if false;
      }


      match /dailyQuestionAnswers/{answerId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId)
          && request.resource.data.keys().hasOnly([
            'uid',
            'dayKey',
            'answer',
            'createdAt',
            'createdAtClientMs'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.dayKey is string
          && request.resource.data.dayKey.size() == 10
          && answerId == request.resource.data.dayKey + '_' + request.auth.uid
          && request.resource.data.answer is string
          && request.resource.data.answer.size() > 0
          && request.resource.data.answer.size() <= 500
          && request.resource.data.createdAtClientMs is int;
        allow update, delete: if false;
      }

      match /dailyChoiceAnswers/{answerId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId)
          && request.resource.data.keys().hasOnly([
            'uid',
            'dayKey',
            'ownChoice',
            'partnerGuess',
            'createdAt',
            'createdAtClientMs'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.dayKey is string
          && request.resource.data.dayKey.size() == 10
          && answerId == request.resource.data.dayKey + '_' + request.auth.uid
          && request.resource.data.ownChoice in ['a', 'b']
          && request.resource.data.partnerGuess in ['a', 'b']
          && request.resource.data.createdAtClientMs is int;
        allow update, delete: if false;
      }

      match /dailyQuestCompletions/{completionId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId)
          && request.resource.data.keys().hasOnly([
            'uid',
            'dayKey',
            'completedAt',
            'completedAtClientMs'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.dayKey is string
          && request.resource.data.dayKey.size() == 10
          && completionId == request.resource.data.dayKey + '_' + request.auth.uid
          && request.resource.data.completedAtClientMs is int;
        allow update, delete: if false;
      }

      match /goals/{goalId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId)
          && request.resource.data.keys().hasOnly([
            'title',
            'target',
            'currency',
            'createdBy',
            'createdAt',
            'createdAtClientMs'
          ])
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 80
          && request.resource.data.target is int
          && request.resource.data.target >= 1
          && request.resource.data.target <= 100000000
          && request.resource.data.currency == 'RUB'
          && request.resource.data.createdAtClientMs is int;
        allow update, delete: if false;

        match /contributions/{contributionId} {
          allow read: if isCoupleMember(coupleId);
          allow create: if isCoupleMember(coupleId)
            && exists(/databases/$(database)/documents/couples/$(coupleId)/goals/$(goalId))
            && request.resource.data.keys().hasOnly([
              'uid',
              'amount',
              'note',
              'createdAt',
              'createdAtClientMs'
            ])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.amount is int
            && request.resource.data.amount >= 1
            && request.resource.data.amount <= 10000000
            && request.resource.data.note is string
            && request.resource.data.note.size() <= 100
            && request.resource.data.createdAtClientMs is int;
          allow update, delete: if false;
        }
      }
    }
  }
}
