rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(coupleId) {
      return signedIn()
        && exists(/databases/$(database)/documents/couples/$(coupleId))
        && request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
    }

    function validCreateCouple() {
      return signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds[0] == request.auth.uid;
    }

    function validJoin() {
      return signedIn()
        && resource.data.memberIds is list
        && request.resource.data.memberIds is list
        && !(request.auth.uid in resource.data.memberIds)
        && resource.data.memberIds.size() == 1
        && request.resource.data.memberIds.size() == 2
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['memberIds', 'members', 'updatedAt']);
    }

    function validMemberEdit(coupleId) {
      return isMember(coupleId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'members', 'updatedAt']);
    }

    match /users/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /couples/{coupleId} {
      allow create: if validCreateCouple();
      allow read: if isMember(coupleId);
      allow update: if validJoin() || validMemberEdit(coupleId);
      allow delete: if false;

      // Every document below a couple belongs to the two members of that couple.
      // This single descendant rule also covers deeply nested paths such as
      // plans/{scope}/options/{id} and goals/{goalId}/contributions/{id}.
      match /{subcollection}/{document=**} {
        allow read, create, update, delete: if isMember(coupleId);
      }
    }
  }
}
