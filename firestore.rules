rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(coupleId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
    }

    function validCreateCouple() {
      return signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds[0] == request.auth.uid;
    }

    function validJoin() {
      return signedIn()
        && !(request.auth.uid in resource.data.memberIds)
        && resource.data.memberIds.size() == 1
        && request.resource.data.memberIds.size() == 2
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['memberIds', 'members', 'updatedAt']);
    }

    function validMemberEdit(coupleId) {
      return isMember(coupleId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'members', 'updatedAt']);
    }

    match /users/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /couples/{coupleId} {
      allow create: if validCreateCouple();
      allow read: if isMember(coupleId);
      allow update: if validJoin() || validMemberEdit(coupleId);
      allow delete: if false;

      // Приложение приватное и состоит только из двух участников пары.
      // Любые вложенные данные доступны только участникам этого пространства.
      match /{subcollection}/{docId} {
        allow read, create, update: if isMember(coupleId);
        allow delete: if false;
      }

      match /{subcollection}/{docId}/{nested=**} {
        allow read, create, update: if isMember(coupleId);
        allow delete: if false;
      }
    }
  }
}
